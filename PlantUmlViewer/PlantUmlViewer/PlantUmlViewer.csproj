<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Build target -->
    <TargetFramework>net462</TargetFramework>
    <OutputType>Library</OutputType>
    <Platforms>x86;x64</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Frameworks and language features -->
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Assembly identity and versioning -->
    <Version>1.9.0.13</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <!-- Assembly metadata -->
    <Title>PlantUmlViewer</Title>
    <Description>PlantUML Viewer</Description>
    <Product>PlantUML Viewer by Philipp Schmidt</Product>
    <Company>Schmidt</Company>
    <Authors>Philipp Schmidt</Authors>
    <Copyright>Copyright © 2022 - $([System.DateTime]::UtcNow.Year), all rights reserved</Copyright>
    <!-- Code analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>10.0-all</AnalysisLevel>
    <!-- Diagnostics -->
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <!-- Map the source paths for reproducible builds, but not while debugging since it prevents binding breakpoints -->
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)').TrimEnd('\'))=./</PathMap>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug-x86</OutputPath>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <DebugSymbols>false</DebugSymbols>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release-x86</OutputPath>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug-x64</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <DebugSymbols>false</DebugSymbols>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release-x64</OutputPath>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Default values for debugging so it start correct version of Notepad++
         $(ProgramW6432) and $(MSBuildProgramFiles32) points to the 64 and 32 bit "Program Files" directories -->
    <StartAction>Program</StartAction>
    <!--<StartProgram Condition="'$(Platform)'=='x64'">$(ProgramW6432)\Notepad++\notepad++.exe</StartProgram>
    <StartProgram Condition="'$(Platform)'=='x86'">$(MSBuildProgramFiles32)\Notepad++\notepad++.exe</StartProgram>-->
    <StartProgram Condition="'$(Platform)'=='x64'">C:\Users\phili\Documents\Workspace_PlantUmlViewer\npp.8.8.9.portable.x64\notepad++.exe</StartProgram>
    <StartProgram Condition="'$(Platform)'=='x86'">C:\Users\phili\Documents\Workspace_PlantUmlViewer\npp.8.8.9.portable\notepad++.exe</StartProgram>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CyotekImageBox" Version="1.5.0" />
    <PackageReference Include="MSBuild.ILMerge.Task" Version="1.1.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Svg" Version="3.4.8" />
  </ItemGroup>

  <!-- The MSBuild.ILMerge.Task props/targets are imported automatically by NuGet via PackageReference,
       no explicit <Import> of the packages folder is needed. -->
  <Import Project="$(MSBuildProjectDirectory)\PluginInfrastructure\DllExport\NppPlugin.DllExport.targets" />

  <!-- MSBuild.ILMerge.Task builds its input list from @(ReferencePath) items carrying CopyLocal='true' metadata,
       which is only set for packages.config style references. With PackageReference the list stays empty and
       only the main assembly gets "merged", so rebuild it from @(ReferenceCopyLocalPaths) instead. -->
  <Target Name="CollectILMergeAssemblies" AfterTargets="SaveILMergeData">
    <ItemGroup>
      <ILMergeInputAssemblies Include="@(ReferenceCopyLocalPaths)" Condition=" '%(Extension)' == '.dll' AND '%(ReferenceCopyLocalPaths.DestinationSubDirectory)' == '' " />
    </ItemGroup>
    <PropertyGroup>
      <MergedAssemblies>@(IntermediateAssembly->'%(FullPath)');@(ILMergeInputAssemblies->'%(FullPath)')</MergedAssemblies>
    </PropertyGroup>
  </Target>

</Project>
